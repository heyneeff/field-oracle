{
  "name": "field-oracle",
  "version": "1.0.0",
  "description": "Field Oracle FO-64 — iOS app wrapper (Capacitor) around the web console",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "ios:sync": "mkdir -p www && cp web/field-oracle.html www/index.html && npx cap copy ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "icons:generate": "npx capacitor-assets generate --ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyneeff/field-oracle.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/heyneeff/field-oracle/issues"
  },
  "homepage": "https://github.com/heyneeff/field-oracle#readme",
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2"
  }
}
